# --- SERV Reasoning (console.openserv.ai -> API keys) ---
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
# Used only for hard cases (low confidence on first pass)
SERV_HARD_MODEL=gpt-5.4-mini-serv-multipath

# --- Server ---
PORT=3000
PUBLIC_URL=http://localhost:3000
DEBUG=0

# --- Payments ---
# off  = no payment needed (use while building)
# on   = real x402 via Pieverse facilitator
PAYMENTS_MODE=off
KITE_NETWORK=eip155:2368
FACILITATOR_URL=https://facilitator.pieverse.io/v2
# Your seller wallet on Kite
PAY_TO=0xYourWalletAddress
# Token contract the agent pays in (check /v2/supported or Kite docs for the testnet stablecoin)
PAY_ASSET=0x38129cf4CE5E183eFF248F42A7D345Bb1B47621A
# Token decimals (18 per Kite docs example)
ASSET_DECIMALS=18

# Demo buyer only. Set locally in ignored .env; never commit or share this key.
BUYER_PRIVATE_KEY=
