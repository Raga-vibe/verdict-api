# --- SERV Reasoning (console.openserv.ai -> API keys) ---
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini
# Used only for hard cases (low confidence on first pass)
SERV_HARD_MODEL=gpt-5.4-mini-serv-multipath

# --- Server ---
PORT=3000
PUBLIC_URL=http://localhost:3000
DEBUG=0

# --- Payments: Celo x402 (this branch) ---
# off  = no payment needed (use while building)
# on   = real x402 via the Celo facilitator
PAYMENTS_MODE=off
# Celo Sepolia testnet by default. Mainnet: eip155:42220
X402_NETWORK=eip155:11142220
# Defaults follow X402_NETWORK, so these two are optional:
# FACILITATOR_URL=https://api.x402.sepolia.celo.org
# FACILITATOR_URL=https://api.x402.celo.org
# Your seller wallet on Celo (receives the USDC / cNGN)
PAY_TO=0xYourWalletAddress
# Created by a human at https://x402.celo.org (Create API key, sign,
# copy once). Sent only to the facilitator as X-API-Key. Without it
# /settle returns 401. Never commit it.
X402_API_KEY=
# ERC-8021 builder code declared in 402 responses. If Loops / Celo
# issues an assigned code (celo_xxxxxxxx), set it here instead.
ATTRIBUTION_CODE=verdict_api

# --- Self Agent ID (Track 3) ---
# SELF_VERIFY=on enforces Self on POST /verdict/claim.
# Default off so Sepolia testing works before registration.
SELF_VERIFY=off
# testnet (Celo Sepolia, mock documents accepted) or mainnet
# (real passport/ID only). Defaults follow X402_NETWORK.
SELF_NETWORK=testnet
# SELF_RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# --- Textile FX (Track 1, cNGN) ---
# TEXTILE_API_KEY is a live key for mainnet, tx_test_... for testnets.
# Testnets are BSC 97 and Base Sepolia 84532 ONLY; Celo Sepolia has
# no Textile settlement contract, so TEXTILE_CHAIN=97 for a test sweep.
TEXTILE_API_KEY=
# Mainnet: 42220. Test sweep: 97.
TEXTILE_CHAIN=42220
# dry-run (default: quote only, never broadcast) or live.
TEXTILE_SWEEP=dry-run
# Minimum sweep size in cNGN (mainnet $1 corridor floor).
TEXTILE_MIN_SWEEP_CNGN=2000

# Demo buyers only. Set locally in ignored .env; never commit or share.
BUYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
SWEEP_PRIVATE_KEY=
